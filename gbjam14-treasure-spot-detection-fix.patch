+// The altar's collision slab is the sprite strip at y+48..y+63, so a gem
+// set down on it rests with its feet at y+48. Center the spots on that
+// surface so the gems actually overlap them. (No dom link: the altar never
+// moves, and a link would delete the spots whenever the altar is culled.)
+var _spot_y = y + 40;
+treasure_spot[0] = instance_create_depth(x + 64,  _spot_y, depth, obj_gbj14_treasure_spot);
+treasure_spot[1] = instance_create_depth(x + 129, _spot_y, depth, obj_gbj14_treasure_spot);
+treasure_spot[2] = instance_create_depth(x + 193, _spot_y, depth, obj_gbj14_treasure_spot);
 
 // obj_block hides level blocks at create; the altar is a visible platform.
 visible = true;
